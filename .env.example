# ===================================================================
# Telegram UserBot & Local Chrome Automation Configuration
# ===================================================================

# Telegram MTProto API Credentials (https://my.telegram.org)
API_ID=39557027
API_HASH=66a67da1376ecf96225c6b06eb69ff23

# Generated StringSession (Run: npm run generate-session)
SESSION_STRING=YOUR_GENERATED_SESSION_STRING

# Target VIP Channel numerical ID (e.g. 1234567890 or -1001234567890)
VIP_CHANNEL_ID=YOUR_NUMERICAL_CHANNEL_ID

# Target Trading / Automation Web Platform
TARGET_URL=https://example.com/trading

# Standby Timeout for "Get ready" warm browser (set to Infinity to never time out)
STANDBY_TIMEOUT_MS=Infinity

# -------------------------------------------------------------------
# Local Windows Chrome (Profile 1) Settings
# -------------------------------------------------------------------
CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PROFILE_NAME=Profile 1
CDP_PORT=9222
CDP_URL=http://127.0.0.1:9222
AUTO_LAUNCH_CHROME=true

# Set to false to see Chrome operate on your desktop
HEADLESS=false
BROWSER_TIMEOUT_MS=30000
